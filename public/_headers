# Cloudflare Pages response headers (copied into dist/ by the build).
# scripts/write-headers.mjs appends a site-wide "X-Robots-Tag: noindex" to dist/_headers
# until SITE_LAUNCHED=true, so pre-launch builds are never indexed.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# The CMS admin page must never be indexed or framed by other sites.
/admin/*
  X-Robots-Tag: noindex
  X-Frame-Options: DENY
