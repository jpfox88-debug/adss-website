{
  "name": "adss-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/write-headers.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "build:launch": "SITE_LAUNCHED=true EXCLUDE_PLACEHOLDERS=true sh -c 'astro build && node scripts/write-headers.mjs' && node scripts/prune-placeholders.mjs && node scripts/check-placeholders.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/work-sans": "^5.3.0",
    "astro": "^7.4.2"
  }
}
