---
import type { EventEntry } from '../lib/content';
import { dateParts, formatDay, formatTimeRange, STATUS_LABEL } from '../lib/site';
import Ph from './Ph.astro';

interface Props {
  event: EventEntry;
  hidden?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { event, hidden = false, headingLevel: H = 'h3' } = Astro.props;
const d = event.data;
const parts = dateParts(event.start);
---
<li class="event" data-event data-end={event.end.toISOString()} data-status={d.status} hidden={hidden}>
  <div class="date" aria-hidden="true">
    <span class="wd">{parts.weekday}</span>
    <span class="day">{parts.day}</span>
    <span class="mon">{parts.month}</span>
  </div>
  <div class="body">
    <H class="title"><a href={`/events/${event.id}/`}><Ph text={d.title} /></a></H>
    <p class="meta">
      <span class="visually-hidden">{formatDay(event.start)}, </span>{formatTimeRange(event.start, event.end)}
      <br /><Ph text={d.venue} />
    </p>
    {d.summary && <p class="summary"><Ph text={d.summary} /></p>}
    {d.status !== 'open' && <p><span class={`status status--${d.status}`}>{STATUS_LABEL[d.status]}</span></p>}
  </div>
</li>

<style>
  .event {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--stone-deep);
    max-width: none;
  }
  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.6rem 0.4rem;
    background: var(--navy);
    color: var(--warm-white);
    border-radius: var(--radius);
    line-height: 1.1;
    align-self: start;
    border-left: 6px solid transparent;
    border-image: var(--tartan) 1;
  }
  .wd,
  .mon {
    font-size: var(--step--1);
  }
  .day {
    font: 700 2rem/1 var(--font-display);
  }
  .title {
    font-size: var(--step-2);
    margin-bottom: 0.4rem;
  }
  .title a {
    color: var(--navy);
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .meta {
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }
  .summary {
    margin-bottom: 0.5rem;
  }
</style>
