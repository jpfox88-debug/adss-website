---
// An event's own image, or an illustrative Scottish landscape when none has been uploaded.
// Illustrative images carry a discreet caption so they're never mistaken for Society photos.
import { Image } from 'astro:assets';
import type { EventEntry } from '../lib/content';
import fallback from '../assets/stock/shetland-eshaness-coast.jpg';

interface Props {
  event: EventEntry;
  widths?: number[];
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { event, widths = [480, 960, 1440], sizes, eager = false, class: className } = Astro.props;
const own = event.data.image;
const src = own ?? fallback;
const illustrative = !own || event.data.image_illustrative;
const alt = own ? event.data.image_alt ?? '' : 'Illustrative image: sea stacks off the Eshaness coast, Shetland';
---
<figure class:list={['event-image', className]}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} quality={72} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  {illustrative && <figcaption>Illustrative image</figcaption>}
</figure>

<style>
  .event-image {
    position: relative;
    margin: 0;
  }
  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }
  figcaption {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: rgba(14, 24, 48, 0.72);
    color: var(--cream);
    font-size: 0.8rem;
  }
</style>
