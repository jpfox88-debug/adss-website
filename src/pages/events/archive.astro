---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import headerPhoto from '../../assets/stock/edinburgh-victoria-street.jpg';
import { getEvents, isPastAtBuild } from '../../lib/content';

// Most recent first; the shared script hides any that haven't finished yet.
const events = (await getEvents()).reverse();
const anyPast = events.some((e) => isPastAtBuild(e));
---
<Base
  title="Past events"
  description="An archive of past Scottish Society Abu Dhabi events, with links to photos and videos."
  overlayHeader
>
  <PageHeader title="Past events" image={headerPhoto} position="50% 30%">
    <p>A record of what we've been up to. Photos and videos are in <a href="/photos/">Photos & Videos</a>.</p>
  </PageHeader>

  <div class="wrap list-wrap">
    <ul class="events" id="past-events" data-event-list="past">
      {events.map((e) => <EventCard event={e} hidden={!isPastAtBuild(e)} headingLevel="h2" />)}
    </ul>
    <p data-event-empty="past-events" hidden={anyPast}>No past events have been added yet.</p>
    <p class="back"><a href="/events/">Upcoming Events</a></p>
  </div>
</Base>

<script>
  import '../../scripts/event-visibility';
</script>

<style>
  .list-wrap {
    padding-block: var(--space-5) var(--space-6);
  }
  .events {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .back {
    margin-top: var(--space-4);
  }
</style>
