---
// Written from an audit of what the built site actually uses (2026-10-22): no analytics,
// no cookies on public pages, fonts self-hosted, video embeds only on album pages with videos,
// CMS sign-in on /admin only. Re-check and update this page if any of that changes.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import headerPhoto from '../assets/stock/skye-lighthouse-cliff.jpg';
import Ph from '../components/Ph.astro';
import { getSettings } from '../lib/content';
import { mailLink } from '../lib/site';

const s = await getSettings();
const email = mailLink(s.contact_email, 'Privacy question');
---
<Base title="Privacy" description="How the Scottish Society Abu Dhabi website handles your information." overlayHeader>
  <PageHeader title="Privacy" image={headerPhoto} position="50% 40%">
    <p>This website is deliberately simple: it has no sign-up forms, no payments, no analytics and no advertising.</p>
  </PageHeader>

  <div class="wrap prose">
    <h2>What this website collects</h2>
    <p>Nothing directly. The public pages set no cookies and don't track you. All fonts and images are served from this website itself.</p>

    <h2>Hosting</h2>
    <p>The site is hosted by Netlify. Like any web host, Netlify's servers briefly record technical details such as your IP address and browser type when you load a page, to deliver the site and keep it secure. See <a href="https://www.netlify.com/privacy/" rel="noopener">Netlify's privacy policy</a>.</p>

    <h2>Videos</h2>
    <p>Some photo albums include videos hosted on YouTube or Vimeo. On those pages the video player is loaded from YouTube (in its privacy-enhanced mode) or Vimeo (with tracking turned off), and that service may receive your IP address and browser details. Pages without videos don't contact either service.</p>

    <h2>WhatsApp, email and maps</h2>
    <p>Buttons such as “Join via WhatsApp”, booking links, email links and map links take you to that app or service. Nothing is sent until you choose to send a message, and from then on that service's own privacy policy applies. Membership and booking details you send us are used only to arrange your membership or booking.</p>

    <h2>Committee editing area</h2>
    <p>The editing area at /admin is used only by authorised committee members. Signing in there uses a GitHub account (through Netlify) and keeps the editor's sign-in in their own browser. Visitors to the public site never use it.</p>

    <h2>Questions</h2>
    <p>Contact the society at {email ? <a href={email}>{s.contact_email}</a> : <Ph text={s.contact_email} />}.</p>
    <p class="updated">Last updated 22 October 2026.</p>
  </div>
</Base>

<style>
  .prose {
    padding-block: var(--space-5) var(--space-6);
  }
  .prose h2 {
    font-size: var(--step-2);
    margin-top: var(--space-4);
  }
  .updated {
    color: var(--ink-soft);
    margin-top: var(--space-4);
  }
</style>
