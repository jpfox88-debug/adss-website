---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ph from '../../components/Ph.astro';
import { albumCover, albumPageCount, getAlbums, getEvents, isStaticPhoto, PHOTOS_PER_PAGE, type AlbumEntry } from '../../lib/content';
import { formatDay, isPlaceholder, videoEmbed } from '../../lib/site';

// /photos/<slug>/ shows the first PHOTOS_PER_PAGE photos; longer albums continue at
// /photos/<slug>/2/, /photos/<slug>/3/, … in the album's order. Short albums are a single page.
export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.flatMap((album) =>
    Array.from({ length: albumPageCount(album) }, (_, i) => ({
      params: { path: i === 0 ? album.id : `${album.id}/${i + 1}` },
      props: { album, page: i + 1 },
    })),
  );
}

const { album, page } = Astro.props as { album: AlbumEntry; page: number };
const d = album.data;
const { Content } = await render(album);
const event = d.event ? (await getEvents()).find((e) => e.id === d.event) : undefined;

const pageCount = albumPageCount(album);
const first = (page - 1) * PHOTOS_PER_PAGE;
const pagePhotos = d.photos.slice(first, first + PHOTOS_PER_PAGE);
const pageHref = (n: number) => (n === 1 ? `/photos/${album.id}/` : `/photos/${album.id}/${n}/`);

// Both photo shapes (docs/DECISIONS.md D15) normalised for the grid and the lightbox:
// pre-sized photos use their thumb in the grid and the full file in the lightbox;
// pipeline photos are resized here.
const photos = await Promise.all(
  pagePhotos.map(async (p, i) => {
    const index = first + i;
    const caption = isPlaceholder(p.caption) ? '' : p.caption ?? '';
    if (isStaticPhoto(p)) return { kind: 'static' as const, index, alt: p.alt, caption, full: p.src, thumb: p.thumb, width: p.width, height: p.height };
    return { kind: 'image' as const, index, alt: p.alt, caption, image: p.image, full: (await getImage({ src: p.image, width: 1800, format: 'webp' })).src };
  }),
);
// Videos appear once, on the first page.
const videos = page === 1 ? d.videos.map((v) => ({ ...v, embed: videoEmbed(v.url) })) : [];
const cover = albumCover(album);
const shareImage = cover.kind === 'image' ? cover.image : cover.full;
const pageSuffix = pageCount > 1 ? ` (page ${page} of ${pageCount})` : '';
const title = `${d.title}${pageSuffix}`;
const description = `Photos${d.videos.length ? ' and videos' : ''} from ${d.title}, ${formatDay(album.date)}.${pageSuffix}`;
---
<Base title={title} description={description} image={shareImage} imageAlt={d.cover_alt}>
  <div class="wrap page-head">
    <p class="crumb"><a href="/photos/">Photos & Videos</a></p>
    <span class="accent-rule" aria-hidden="true"></span>
    <h1><Ph text={d.title} /></h1>
    {d.placeholder && <p class="layout-note" data-preview-only>Layout preview with placeholder images — not a Society album. It isn't listed on the site and is left out of the launch build.</p>}
    <p>
      {formatDay(album.date)}
      {event && <> · <a href={`/events/${event.id}/`}>Event details</a></>}
      {pageCount > 1 && <> · Photos {first + 1}–{first + pagePhotos.length} of {d.photos.length}</>}
    </p>
    <div class="intro"><Content /></div>
  </div>

  <div class="wrap content">
    {photos.length > 0 && (
      <section aria-labelledby="photos-title">
        <h2 id="photos-title" class="visually-hidden">Photos{pageSuffix}</h2>
        <ul class="grid" data-gallery data-total={d.photos.length}>
          {photos.map((p) => (
            <li>
              <a href={p.full} data-full={p.full} data-caption={p.caption} data-index={p.index}>
                {p.kind === 'static' ? (
                  <img src={p.thumb} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
                ) : (
                  <Image
                    src={p.image}
                    alt={p.alt}
                    widths={[320, 640]}
                    sizes="(min-width: 72rem) 17rem, (min-width: 40rem) 30vw, 46vw"
                    loading="lazy"
                  />
                )}
              </a>
              {p.caption && <p class="caption"><Ph text={p.caption} /></p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {pageCount > 1 && (
      <nav class="pager" aria-label="Album pages">
        {page > 1 ? <a class="btn btn--outline" href={pageHref(page - 1)} rel="prev">‹ Previous</a> : <span class="btn btn--outline is-disabled" aria-hidden="true">‹ Previous</span>}
        <ol class="pages">
          {Array.from({ length: pageCount }, (_, i) => i + 1).map((n) => (
            <li>
              {n === page ? (
                <span class="page-link is-current" aria-current="page">{n}</span>
              ) : (
                <a class="page-link" href={pageHref(n)}><span class="visually-hidden">Page </span>{n}</a>
              )}
            </li>
          ))}
        </ol>
        {page < pageCount ? <a class="btn btn--outline" href={pageHref(page + 1)} rel="next">Next ›</a> : <span class="btn btn--outline is-disabled" aria-hidden="true">Next ›</span>}
      </nav>
    )}

    {videos.length > 0 && (
      <section aria-labelledby="videos-title" class="videos">
        <h2 id="videos-title">Videos</h2>
        {videos.map((v) =>
          v.embed ? (
            <figure>
              <div class="video">
                <iframe
                  src={v.embed}
                  title={v.title}
                  loading="lazy"
                  allow="encrypted-media; picture-in-picture; fullscreen"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen></iframe>
              </div>
              <figcaption>{v.title}</figcaption>
            </figure>
          ) : null,
        )}
      </section>
    )}
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <figure>
      <img alt="" />
      <figcaption><span class="lb-caption"></span> <span class="lb-count"></span></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="lb-btn lb-next" aria-label="Next photo">›</button>
    <button type="button" class="lb-btn lb-close" aria-label="Close photo viewer">×</button>
  </dialog>
</Base>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const links = Array.from(gallery?.querySelectorAll<HTMLAnchorElement>('a') ?? []);
  // The lightbox moves through this page's photos; the counter shows the position in the whole album.
  const total = Number(gallery?.dataset.total) || links.length;
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dialog && links.length && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector<HTMLElement>('.lb-caption')!;
    const count = dialog.querySelector<HTMLElement>('.lb-count')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.dataset.full!;
      img.alt = link.querySelector('img')?.alt ?? '';
      caption.textContent = link.dataset.caption ?? '';
      count.textContent = `${Number(link.dataset.index ?? index) + 1} of ${total}`;
      // Preload neighbours so next/previous feels instant.
      [index + 1, index - 1].forEach((n) => {
        const l = links[(n + links.length) % links.length];
        new Image().src = l.dataset.full!;
      });
    };

    prev.hidden = next.hidden = links.length < 2;

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      }),
    );
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    // Clicking the backdrop (outside the figure) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // Swipe on touch screens.
    let startX: number | null = null;
    dialog.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') startX = e.clientX;
    });
    dialog.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .layout-note {
    display: inline-block;
    background: var(--placeholder-bg);
    color: var(--placeholder-ink);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius);
    font-size: var(--step--1);
  }
  .crumb {
    margin-bottom: var(--space-1);
  }
  .intro :global(p) {
    color: var(--ink-soft);
  }
  .content {
    padding-bottom: var(--space-5);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 15rem), 1fr));
    gap: var(--space-2);
  }
  .grid li {
    max-width: none;
  }
  .grid a {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .caption {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: 0.3rem 0 0;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .pages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
  }
  .pages li {
    max-width: none;
  }
  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.6rem;
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
    color: var(--navy);
    border: 1px solid var(--stone-deep);
    background: var(--paper);
  }
  .page-link:hover {
    text-decoration: underline;
  }
  .page-link.is-current {
    background: var(--navy);
    color: var(--warm-white);
    border-color: var(--navy);
  }
  .btn.is-disabled {
    opacity: 0.45;
    pointer-events: none;
  }
  .videos {
    margin-top: var(--space-5);
  }
  .videos figure {
    margin: 0 0 var(--space-4);
    max-width: 52rem;
  }
  .video {
    aspect-ratio: 16 / 9;
    background: var(--navy);
  }
  .video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .videos figcaption {
    margin-top: 0.5rem;
    font-weight: 700;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 16, 30, 0.96);
    color: var(--warm-white);
    touch-action: pan-y;
  }
  .lightbox::backdrop {
    background: rgba(10, 16, 30, 0.96);
  }
  .lightbox figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 4.5rem 1.5rem;
    pointer-events: none;
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 8rem);
    object-fit: contain;
    pointer-events: auto;
  }
  .lightbox figcaption {
    margin-top: 0.75rem;
    text-align: center;
  }
  .lb-count {
    color: #c9cedb;
    margin-left: 0.5rem;
  }
  .lb-btn {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid rgba(250, 248, 243, 0.6);
    background: rgba(20, 33, 61, 0.8);
    color: var(--warm-white);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb-btn:focus-visible {
    box-shadow: 0 0 0 3px var(--warm-white);
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 0.75rem;
  }
  .lb-next {
    right: 0.75rem;
  }
  .lb-close {
    top: 0.75rem;
    right: 0.75rem;
  }
  @media (max-width: 40rem) {
    .lightbox figure {
      padding: 4rem 0.5rem 5rem;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
</style>
