---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Ph from '../../components/Ph.astro';
import { getAlbums } from '../../lib/content';
import { formatDay } from '../../lib/site';

const albums = await getAlbums();
---
<Base
  title="Photos & Videos"
  description="Photos and videos from Scottish Society Abu Dhabi events, organised by event."
>
  <div class="wrap page-head">
    <h1>Photos & Videos</h1>
    <p>Albums from our events, most recent first.</p>
  </div>

  <div class="wrap list-wrap">
    {albums.length === 0 ? (
      <p>Albums from our events will appear here soon.</p>
    ) : (
      <ul class="albums">
        {albums.map((a) => (
          <li>
            <a href={`/photos/${a.id}/`}>
              <Image
                src={a.data.cover}
                alt=""
                widths={[400, 800, 1200]}
                sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 92vw"
                loading="lazy"
              />
              <span class="title"><Ph text={a.data.title} /></span>
            </a>
            <span class="meta">
              {formatDay(a.date)}
              <br />
              {a.data.photos.length} {a.data.photos.length === 1 ? 'photo' : 'photos'}
              {a.data.videos.length > 0 && <>, {a.data.videos.length} {a.data.videos.length === 1 ? 'video' : 'videos'}</>}
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<style>
  .list-wrap {
    padding-bottom: var(--space-5);
  }
  .albums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4) var(--space-3);
  }
  .albums li {
    max-width: none;
  }
  .albums a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--navy);
  }
  .albums img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-2);
  }
  .title {
    font: 700 var(--step-1) / 1.2 var(--font-display);
  }
  .albums a:hover .title {
    text-decoration: underline;
  }
  .meta {
    color: var(--ink-soft);
  }
</style>
