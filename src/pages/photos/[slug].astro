---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ph from '../../components/Ph.astro';
import { getAlbums, getEvents, type AlbumEntry } from '../../lib/content';
import { formatDay, isPlaceholder, videoEmbed } from '../../lib/site';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album) => ({ params: { slug: album.id }, props: { album } }));
}

const { album } = Astro.props as { album: AlbumEntry };
const d = album.data;
const { Content } = await render(album);
const event = d.event ? (await getEvents()).find((e) => e.id === d.event) : undefined;

// Full-size versions for the lightbox (and the no-JavaScript link target).
const photos = await Promise.all(
  d.photos.map(async (p) => ({ ...p, full: (await getImage({ src: p.image, width: 1800, format: 'webp' })).src })),
);
const videos = d.videos.map((v) => ({ ...v, embed: videoEmbed(v.url) }));
const description = `Photos${videos.length ? ' and videos' : ''} from ${d.title}, ${formatDay(album.date)}.`;
---
<Base title={d.title} description={description} image={d.cover} imageAlt={d.cover_alt}>
  <div class="wrap page-head">
    <p class="crumb"><a href="/photos/">Photos & Videos</a></p>
    <h1><Ph text={d.title} /></h1>
    <p>
      {formatDay(album.date)}
      {event && <> · <a href={`/events/${event.id}/`}>Event details</a></>}
    </p>
    <div class="intro"><Content /></div>
  </div>

  <div class="wrap content">
    {photos.length > 0 && (
      <section aria-labelledby="photos-title">
        <h2 id="photos-title" class="visually-hidden">Photos</h2>
        <ul class="grid" data-gallery>
          {photos.map((p, i) => (
            <li>
              <a href={p.full} data-full={p.full} data-caption={isPlaceholder(p.caption) ? '' : p.caption ?? ''} data-index={i}>
                <Image
                  src={p.image}
                  alt={p.alt}
                  widths={[320, 640]}
                  sizes="(min-width: 72rem) 17rem, (min-width: 40rem) 30vw, 46vw"
                  loading="lazy"
                />
              </a>
              {p.caption && <p class="caption"><Ph text={p.caption} /></p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {videos.length > 0 && (
      <section aria-labelledby="videos-title" class="videos">
        <h2 id="videos-title">Videos</h2>
        {videos.map((v) =>
          v.embed ? (
            <figure>
              <div class="video">
                <iframe
                  src={v.embed}
                  title={v.title}
                  loading="lazy"
                  allow="encrypted-media; picture-in-picture; fullscreen"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen></iframe>
              </div>
              <figcaption>{v.title}</figcaption>
            </figure>
          ) : null,
        )}
      </section>
    )}
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <figure>
      <img alt="" />
      <figcaption><span class="lb-caption"></span> <span class="lb-count"></span></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-prev" aria-label="Previous photo">‹</button>
    <button type="button" class="lb-btn lb-next" aria-label="Next photo">›</button>
    <button type="button" class="lb-btn lb-close" aria-label="Close photo viewer">×</button>
  </dialog>
</Base>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-gallery] a'));
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dialog && links.length && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector<HTMLElement>('.lb-caption')!;
    const count = dialog.querySelector<HTMLElement>('.lb-count')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.dataset.full!;
      img.alt = link.querySelector('img')?.alt ?? '';
      caption.textContent = link.dataset.caption ?? '';
      count.textContent = `${index + 1} of ${links.length}`;
      // Preload neighbours so next/previous feels instant.
      [index + 1, index - 1].forEach((n) => {
        const l = links[(n + links.length) % links.length];
        new Image().src = l.dataset.full!;
      });
    };

    prev.hidden = next.hidden = links.length < 2;

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      }),
    );
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    // Clicking the backdrop (outside the figure) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // Swipe on touch screens.
    let startX: number | null = null;
    dialog.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') startX = e.clientX;
    });
    dialog.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .crumb {
    margin-bottom: var(--space-1);
  }
  .intro :global(p) {
    color: var(--ink-soft);
  }
  .content {
    padding-bottom: var(--space-5);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 15rem), 1fr));
    gap: var(--space-2);
  }
  .grid li {
    max-width: none;
  }
  .grid a {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .caption {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: 0.3rem 0 0;
  }
  .videos {
    margin-top: var(--space-5);
  }
  .videos figure {
    margin: 0 0 var(--space-4);
    max-width: 52rem;
  }
  .video {
    aspect-ratio: 16 / 9;
    background: var(--navy);
  }
  .video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .videos figcaption {
    margin-top: 0.5rem;
    font-weight: 700;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 16, 30, 0.96);
    color: var(--warm-white);
    touch-action: pan-y;
  }
  .lightbox::backdrop {
    background: rgba(10, 16, 30, 0.96);
  }
  .lightbox figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 4.5rem 1.5rem;
    pointer-events: none;
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 8rem);
    object-fit: contain;
    pointer-events: auto;
  }
  .lightbox figcaption {
    margin-top: 0.75rem;
    text-align: center;
  }
  .lb-count {
    color: #c9cedb;
    margin-left: 0.5rem;
  }
  .lb-btn {
    position: absolute;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid rgba(250, 248, 243, 0.6);
    background: rgba(20, 33, 61, 0.8);
    color: var(--warm-white);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb-btn:focus-visible {
    box-shadow: 0 0 0 3px var(--warm-white);
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 0.75rem;
  }
  .lb-next {
    right: 0.75rem;
  }
  .lb-close {
    top: 0.75rem;
    right: 0.75rem;
  }
  @media (max-width: 40rem) {
    .lightbox figure {
      padding: 4rem 0.5rem 5rem;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
</style>
