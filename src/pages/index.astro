---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ph from '../components/Ph.astro';
import BookingButton from '../components/BookingButton.astro';
import { canBeNext, getAlbums, getCommittee, getEvents, getHome, getMembership, isPastAtBuild } from '../lib/content';
import { formatDay, formatMonthYear, formatTimeRange, STATUS_LABEL } from '../lib/site';

const home = await getHome();
const membership = await getMembership();
const committee = await getCommittee();
const albums = (await getAlbums()).slice(0, 6);

// Every event that could be "next" for a visitor at any time after this build.
const candidates = (await getEvents()).filter((e) => canBeNext(e) && !isPastAtBuild(e));
const nextAtBuild = candidates[0];

const firstOption = membership.options[0];
---
<Base
  title="Home"
  description="The Abu Dhabi Scottish Society brings together Scots in Abu Dhabi, their families and anyone who loves Scotland — Burns Supper, ceilidhs, the St Andrew's Ball and more."
  image={home.hero_image}
  imageAlt={home.hero_alt}
  overlayHeader
>
  <section class="hero" aria-labelledby="hero-title">
    {home.hero_image && (
      <Image
        class="hero-img"
        src={home.hero_image}
        alt={home.hero_alt ?? ''}
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <span class="ornament" aria-hidden="true"></span>
      <h1 id="hero-title">{home.hero_heading}</h1>
      <p class="hero-intro"><Ph text={home.hero_intro} /></p>
      <div class="hero-actions">
        <a class="btn btn--light" href="/events/">Upcoming Events</a>
        <a class="btn btn--outline-light" href="/join/">Join the Society</a>
      </div>
    </div>
  </section>

  <section class="invite-section" aria-labelledby="next-title">
    <div class="band" aria-hidden="true"></div>
    <div class="wrap">
      <div class="card">
        <h2 id="next-title" class="card-kicker">Next event</h2>
        <ul class="plain" id="next-event" data-event-list="next">
          {candidates.map((e, i) => (
            <li data-event data-end={e.end.toISOString()} data-status={e.data.status} hidden={i !== 0}>
              <p class="card-title"><a href={`/events/${e.id}/`}><Ph text={e.data.title} /></a></p>
              <span class="rule" aria-hidden="true"></span>
              <p class="card-date">{formatDay(e.start)}</p>
              <p class="card-meta">{formatTimeRange(e.start, e.end)}<br /><Ph text={e.data.venue} /></p>
              {e.data.status !== 'open' && <p><span class={`status status--${e.data.status}`}>{STATUS_LABEL[e.data.status]}</span></p>}
              <div class="card-actions">
                <BookingButton event={e} />
                <a href={`/events/${e.id}/`}>Event details<span class="visually-hidden">: {e.data.title}</span></a>
              </div>
            </li>
          ))}
        </ul>
        <div data-event-empty="next-event" hidden={!!nextAtBuild}>
          <p class="card-title">No events are currently scheduled — follow us or join to hear first.</p>
          <div class="card-actions">
            <a class="btn btn--primary" href="/join/">Join the Society</a>
            <a href="/events/archive/">See past events</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about" aria-labelledby="about-title">
    <div class="wrap about-inner">
      <h2 id="about-title">{home.about_heading}</h2>
      <p class="about-lead"><Ph text={home.about_intro} /></p>
      <ul class="objectives">
        {home.objectives.map((o) => <li><Ph text={o} /></li>)}
      </ul>
    </div>
  </section>

  <section class="join" aria-labelledby="join-title">
    <div class="wrap join-grid">
      <div>
        <h2 id="join-title">Why join?</h2>
        <ul class="benefits">
          {membership.benefits.map((b) => (
            <li>
              <strong><Ph text={b.title} /></strong>
              {b.description && <span><Ph text={b.description} /></span>}
            </li>
          ))}
        </ul>
      </div>
      <div class="join-price">
        {firstOption && (
          <p class="price">
            <span class="price-value"><Ph text={firstOption.price_aed} /></span>
            <span class="price-label"><Ph text={firstOption.name} /></span>
          </p>
        )}
        <p class="join-note">Joining is arranged directly with the society through WhatsApp.</p>
        <a class="btn btn--light" href="/join/">Join the Society</a>
      </div>
    </div>
  </section>

  {albums.length > 0 && (
    <section class="highlights" aria-labelledby="photos-title">
      <div class="wrap section-head">
        <h2 id="photos-title">Recent highlights</h2>
        <a href="/photos/">All photos and videos</a>
      </div>
      <ul class="strip">
        {albums.map((a) => (
          <li>
            <a href={`/photos/${a.id}/`} class="photo-card">
              <Image src={a.data.cover} alt="" widths={[480, 960]} sizes="(min-width: 60rem) 32rem, 85vw" />
              <span class="photo-caption">
                <span class="photo-title"><Ph text={a.data.title} /></span>
                <span class="photo-date">{formatMonthYear(a.date)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="committee" aria-labelledby="committee-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="committee-title">Meet the committee</h2>
        <a href="/committee/">The full committee</a>
      </div>
      <p class="committee-intro"><Ph text={home.committee_intro} /></p>
      {committee.length > 0 && (
        <ul class="people">
          {committee.slice(0, 4).map((c) => (
            <li>
              <a class="person-card" href="/committee/">
                {c.data.photo && <Image src={c.data.photo} alt="" widths={[320, 640]} sizes="(min-width: 60rem) 22vw, 45vw" />}
                <span class="plate">
                  <span class="plate-title"><Ph text={c.data.name} /></span>
                  <span class="plate-sub"><Ph text={c.data.role} /></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<script>
  import '../scripts/event-visibility';
</script>

<style>
  /* ── Hero: symmetrical, engraved capitals on the photo ── */
  .hero {
    position: relative;
    min-height: min(90vh, 54rem);
    display: grid;
    place-items: center;
    background: var(--navy-deep);
    color: var(--warm-white);
    text-align: center;
    overflow: hidden;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(10, 18, 36, 0.55), rgba(10, 18, 36, 0.7) 60%, rgba(10, 18, 36, 0.85));
  }
  .hero-copy {
    position: relative;
    padding-block: 9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ornament {
    position: relative;
    display: block;
    width: 9rem;
    height: 0.75rem;
    margin-bottom: var(--space-3);
    background:
      linear-gradient(var(--rule), var(--rule)) left center / 3.6rem 1px no-repeat,
      linear-gradient(var(--rule), var(--rule)) right center / 3.6rem 1px no-repeat;
  }
  .ornament::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--rule);
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .hero h1 {
    color: var(--warm-white);
    font-size: var(--step-5);
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1.12;
    max-width: 20ch;
    margin-bottom: var(--space-3);
  }
  .hero-intro {
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 36rem;
    color: #e7e2d6;
    margin: 0 auto var(--space-4);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .hero :focus-visible {
    box-shadow: 0 0 0 3px var(--navy-deep), 0 0 0 6px var(--warm-white);
  }

  /* ── Thick tartan band with the invitation card overlapping it ── */
  .invite-section {
    background: var(--warm-white);
    padding-bottom: var(--space-6);
  }
  .band {
    height: 88px;
    background: var(--tartan);
    background-size: 46px 46px;
  }
  .card {
    position: relative;
    max-width: 40rem;
    margin: -56px auto 0;
    background: var(--card);
    padding: var(--space-5) var(--space-4);
    text-align: center;
    box-shadow: 0 24px 50px -28px rgba(18, 32, 63, 0.55);
  }
  /* Engraved corner brackets */
  .card::before,
  .card::after {
    content: '';
    position: absolute;
    width: 2.25rem;
    height: 2.25rem;
    border: 0 solid var(--rule);
  }
  .card::before {
    top: 0.9rem;
    left: 0.9rem;
    border-width: 1px 0 0 1px;
  }
  .card::after {
    bottom: 0.9rem;
    right: 0.9rem;
    border-width: 0 1px 1px 0;
  }
  .card-kicker {
    font: 700 var(--step-0) / 1.2 var(--font-body);
    letter-spacing: 0.04em;
    color: var(--forest-deep);
    margin-bottom: var(--space-2);
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card li,
  .card p {
    max-width: none;
  }
  .card-title {
    font: 600 var(--step-3) / 1.2 var(--font-display);
    letter-spacing: 0.03em;
    color: var(--navy);
    margin-bottom: var(--space-2);
    text-wrap: balance;
  }
  .card-title a {
    color: inherit;
    text-decoration: none;
  }
  .rule {
    display: block;
    width: 4rem;
    height: 1px;
    background: var(--rule);
    margin: 0 auto var(--space-2);
  }
  .card-date {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.2rem;
  }
  .card-meta {
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }
  .card-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  /* ── About: centred, no boxes ── */
  .about {
    padding-block: var(--space-5) var(--space-6);
  }
  .about-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .about h2,
  .section-head h2,
  .join h2 {
    font-size: var(--step-4);
  }
  .about-lead {
    font-size: var(--step-2);
    line-height: 1.45;
    max-width: 44rem;
    margin-bottom: var(--space-4);
  }
  .objectives {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4) var(--space-3);
    max-width: 64rem;
  }
  .objectives li {
    position: relative;
    padding-top: var(--space-3);
  }
  .objectives li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--rule);
    transform: translateX(-50%) rotate(45deg);
  }

  /* ── Why join ── */
  .join {
    background: var(--navy);
    color: var(--warm-white);
    padding-block: var(--space-6);
  }
  .join h2 {
    color: var(--warm-white);
  }
  .join-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
    align-items: center;
  }
  .benefits {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .benefits li {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-2);
    border-top: 1px solid rgba(185, 167, 125, 0.4);
    max-width: none;
  }
  .benefits span,
  .price-label,
  .join-note {
    color: #d5d9e3;
  }
  .join-price {
    text-align: center;
  }
  .price {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-2);
    max-width: none;
  }
  .price-value {
    font: 600 var(--step-4) / 1.15 var(--font-display);
  }
  .join-note {
    max-width: none;
    margin-bottom: var(--space-3);
  }
  .join :focus-visible {
    box-shadow: 0 0 0 3px var(--navy), 0 0 0 6px var(--warm-white);
  }

  /* ── Highlights: a horizontal strip of image cards on navy ── */
  .highlights {
    background: var(--navy-deep);
    color: var(--warm-white);
    padding-block: var(--space-6);
  }
  .highlights .section-head h2,
  .highlights .section-head a {
    color: var(--warm-white);
  }
  .highlights :focus-visible {
    box-shadow: 0 0 0 3px var(--navy-deep), 0 0 0 6px var(--warm-white);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .section-head h2 {
    margin: 0;
  }
  .strip {
    --inset: max(var(--gutter), calc((100vw - var(--page)) / 2 + var(--gutter)));
    list-style: none;
    margin: 0;
    padding: 0 var(--inset) var(--space-2);
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--inset);
  }
  .strip li {
    flex: 0 0 min(85vw, 32rem);
    scroll-snap-align: start;
    max-width: none;
  }
  .photo-card {
    display: block;
    color: var(--warm-white);
    text-decoration: none;
  }
  .photo-card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .photo-caption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: var(--space-2);
  }
  .photo-title {
    font: 600 var(--step-1) / 1.2 var(--font-display);
    letter-spacing: 0.03em;
  }
  .photo-date {
    color: #c9cedb;
  }
  .photo-card:hover .photo-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── Committee: portraits on navy name plates ── */
  .committee {
    background: var(--stone);
    padding-block: var(--space-6);
  }
  .committee-intro {
    font-size: var(--step-1);
    margin-bottom: var(--space-4);
  }
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 14rem), 1fr));
    gap: var(--space-3);
  }
  .people li {
    max-width: none;
  }
  .person-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--warm-white);
    background: var(--navy);
  }
  .person-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .plate {
    padding: var(--space-2);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .plate-title {
    font: 600 var(--step-0) / 1.25 var(--font-display);
    letter-spacing: 0.03em;
  }
  .plate-sub {
    color: #c9cedb;
    font-size: var(--step--1);
  }

  @media (max-width: 48rem) {
    .band {
      height: 48px;
    }
    .card {
      margin-top: -28px;
      padding: var(--space-4) var(--space-3);
    }
  }
</style>
