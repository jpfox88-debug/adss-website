---
// Step 1 scaffold page: proves content collections, the image pipeline and CMS
// edits end-to-end. Replaced by the full homepage in Section 16 step 3.
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';

const home = (await getEntry('home', 'home'))!.data;
const settings = (await getEntry('settings', 'site'))!.data;
const events = await getCollection('events');
const committee = (await getCollection('committee')).sort((a, b) => a.data.order - b.data.order);
const documents = await getCollection('documents');
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{settings.site_name} — build scaffold</title>
  </head>
  <body style="font-family: system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem;">
    <p><strong>Build scaffold</strong> — not the finished site.</p>
    {home.hero_image && <Image src={home.hero_image} alt={home.hero_alt ?? ''} widths={[640, 1280]} sizes="100vw" loading="eager" fetchpriority="high" style="width:100%;height:auto" />}
    <h1>{home.hero_heading}</h1>
    <p>{home.hero_intro}</p>
    <h2>Events</h2>
    <ul>{events.map((e) => <li>{e.data.title} — {e.data.start} ({e.data.status})</li>)}</ul>
    <h2>Committee ({settings.committee_term})</h2>
    <ul>{committee.map((c) => <li>{c.data.name}, {c.data.role}</li>)}</ul>
    <h2>Documents</h2>
    <ul>{documents.map((d) => <li><a href={d.data.file}>{d.data.title}</a></li>)}</ul>
  </body>
</html>
