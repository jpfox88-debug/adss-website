---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ph from '../components/Ph.astro';
import BookingButton from '../components/BookingButton.astro';
import Portrait from '../components/Portrait.astro';
import PhotosComingSoon from '../components/PhotosComingSoon.astro';
import AlbumCover from '../components/AlbumCover.astro';
import logoStacked from '../assets/brand/logo-stacked-reversed.png';
import bandPhoto from '../assets/uploads/headers/band-ceilidh-hall.jpg';
import { canBeNext, getAlbums, getCommittee, getEvents, getHome, getMembership, isGenuineAlbum, isPastAtBuild } from '../lib/content';
import { formatDay, formatMonthYear, formatTimeRange, STATUS_LABEL } from '../lib/site';

const home = await getHome();
const membership = await getMembership();
const committee = await getCommittee();
const allAlbums = await getAlbums();
const albums = allAlbums.filter(isGenuineAlbum).slice(0, 3);
const layoutPreview = process.env.SITE_LAUNCHED !== 'true' ? allAlbums.find((a) => !isGenuineAlbum(a)) : undefined;

// Every event that could be "next" for a visitor at any time after this build.
const candidates = (await getEvents()).filter((e) => canBeNext(e) && !isPastAtBuild(e));
const nextAtBuild = candidates[0];

const firstOption = membership.options[0];
---
<Base
  title="Home"
  description="The Scottish Society Abu Dhabi brings together Scots in Abu Dhabi, their families and anyone who loves Scotland — Burns Supper, ceilidhs, the St Andrew's Ball and more."
  image={home.hero_image}
  imageAlt={home.hero_alt}
  overlayHeader
  headerMarkOnly
>
  <section class="hero" aria-labelledby="hero-title">
    {home.hero_image && (
      <Image
        class="hero-img"
        src={home.hero_image}
        alt={home.hero_alt ?? ''}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="100vw"
        quality={70}
        loading="eager"
        fetchpriority="high"
      />
    )}
    {home.hero_video_mp4 && (
      <video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1">
        {home.hero_video_webm && <source src={home.hero_video_webm} type="video/webm" />}
        <source src={home.hero_video_mp4} type="video/mp4" />
      </video>
    )}
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <Image class="hero-logo" src={logoStacked} alt="" width={420} densities={[1, 2]} loading="eager" />
      <h1 id="hero-title">{home.hero_heading}</h1>
      <p class="hero-intro"><Ph text={home.hero_intro} /></p>
      <div class="hero-actions">
        <a class="btn btn--light" href="/join/">Join the Society</a>
        <a class="btn btn--outline-light" href="/events/">Upcoming Events</a>
      </div>
    </div>
  </section>

  <section class="invite-band" aria-labelledby="next-title">
    <Image class="band-img" src={bandPhoto} alt="" widths={[640, 1280, 1920]} sizes="100vw" quality={60} loading="lazy" />
    <div class="band-shade" aria-hidden="true"></div>
    <div class="wrap">
      <div class="card">
        <h2 id="next-title" class="card-kicker"><span class="accent-rule" aria-hidden="true"></span>Next event</h2>
        <ul class="plain" id="next-event" data-event-list="next">
          {candidates.map((e, i) => (
            <li data-event data-end={e.end.toISOString()} data-status={e.data.status} hidden={i !== 0}>
              <p class="card-title"><a href={`/events/${e.id}/`}><Ph text={e.data.title} /></a></p>
              <p class="card-date">{formatDay(e.start)}</p>
              <p class="card-time">{formatTimeRange(e.start, e.end)}</p>
              <p class="card-venue"><Ph text={e.data.venue} /></p>
              {e.data.status !== 'open' && <p><span class={`status status--${e.data.status}`}>{STATUS_LABEL[e.data.status]}</span></p>}
              <div class="card-actions">
                <BookingButton event={e} />
                <a href={`/events/${e.id}/`}>Event details<span class="visually-hidden">: {e.data.title}</span></a>
              </div>
            </li>
          ))}
        </ul>
        <div data-event-empty="next-event" hidden={!!nextAtBuild}>
          <p class="card-title">No events are currently scheduled — follow us or join to hear first.</p>
          <div class="card-actions">
            <a class="btn btn--primary" href="/join/">Join the Society</a>
            <a href="/events/archive/">See past events</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <div>
        <span class="accent-rule" aria-hidden="true"></span>
        <h2 id="about-title">{home.about_heading}</h2>
        <p class="about-lead"><Ph text={home.about_intro} /></p>
      </div>
      <ul class="objectives">
        {home.objectives.map((o) => <li><Ph text={o} /></li>)}
      </ul>
    </div>
  </section>

  <section class="join" aria-labelledby="join-title">
    <div class="wrap">
      <div class="join-panel">
        <div>
          <h2 id="join-title">Why join?</h2>
          <ul class="benefits">
            {membership.benefits.map((b) => (
              <li>
                <strong><Ph text={b.title} /></strong>
                {b.description && <span><Ph text={b.description} /></span>}
              </li>
            ))}
          </ul>
        </div>
        <div class="join-aside">
          {firstOption && (
            <p class="price">
              <span class="price-value"><Ph text={firstOption.price_aed} /></span>
              <span class="price-label"><Ph text={firstOption.name} /></span>
            </p>
          )}
          <p class="join-note"><Ph text={membership.home_note ?? 'Membership is arranged directly with the Society.'} /></p>
          <a class="btn btn--primary" href="/join/">{membership.home_button ?? 'Join the Society'}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="highlights" aria-labelledby="photos-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="photos-title">Recent highlights</h2>
        {albums.length > 0 && <a href="/photos/">All photos and videos</a>}
      </div>
      {albums.length > 0 ? (
        <ul class="cards">
          {albums.map((a) => (
            <li>
              <a href={`/photos/${a.id}/`} class="photo-card">
                <AlbumCover album={a} sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 92vw" />
                <span class="caption-panel">
                  <span class="caption-title"><Ph text={a.data.title} /></span>
                  <span class="caption-sub">{formatMonthYear(a.date)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <PhotosComingSoon previewHref={layoutPreview ? `/photos/${layoutPreview.id}/` : null} />
      )}
    </div>
  </section>

  <section class="committee" aria-labelledby="committee-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="committee-title">Meet the committee</h2>
        <a href="/committee/">The full committee</a>
      </div>
      <p class="committee-intro"><Ph text={home.committee_intro} /></p>
      {committee.length > 0 && (
        <div class="people-slider" data-slider>
          <button type="button" class="slider-btn slider-prev" data-slider-prev aria-label="Previous committee members">&#8249;</button>
          <ul class="people" data-slider-track aria-label="Committee members">
            {committee.map((c) => (
              <li>
                <a class="photo-card" href="/committee/">
                  <Portrait photo={c.data.photo} name={c.data.name} alt={c.data.photo_alt} sizes="(min-width: 60rem) 14rem, 60vw" />
                  <span class="caption-panel">
                    <span class="caption-title"><Ph text={c.data.name} /></span>
                    <span class="caption-sub"><Ph text={c.data.role} /></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <button type="button" class="slider-btn slider-next" data-slider-next aria-label="Next committee members">&#8250;</button>
        </div>
      )}
    </div>
  </section>
</Base>

<script>
  import '../scripts/event-visibility';

  // Don't fetch the hero video for visitors who prefer reduced motion; otherwise make sure it plays
  // (Low Power Mode on iPhone can block autoplay — the photo shows if that happens).
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
  if (heroVideo && getComputedStyle(heroVideo).display === 'none') {
    heroVideo.remove();
  } else if (heroVideo) {
    heroVideo.play().catch(() => heroVideo.remove());
  }

  // Committee slider: scroll one viewport of cards per click; disable arrows at the ends.
  for (const slider of document.querySelectorAll<HTMLElement>('[data-slider]')) {
    const track = slider.querySelector<HTMLElement>('[data-slider-track]');
    const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');
    if (!track || !prev || !next) continue;
    const update = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };
    const step = () => Math.max(track.clientWidth * 0.8, 200);
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* ── Hero: full-bleed Scottish photo under a navy gradient ── */
  .hero {
    position: relative;
    min-height: min(80vh, 46rem);
    display: grid;
    place-items: center;
    background: var(--navy-deep);
    color: var(--on-navy);
    text-align: center;
    overflow: hidden;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  /* The video sits over the photo on every screen size; the photo is the first frame and the
     fallback, and is what visitors who prefer reduced motion see. */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video { display: none; }
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 46rem 30rem at 50% 52%, rgba(14, 24, 48, 0.62), rgba(14, 24, 48, 0) 70%),
      linear-gradient(180deg, rgba(10, 17, 34, 0.55) 0%, rgba(14, 24, 48, 0.35) 38%, rgba(14, 24, 48, 0.7) 100%);
  }
  .hero-copy {
    position: relative;
    padding-block: 7.5rem var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-logo {
    width: min(380px, 80vw);
    height: auto;
    margin-bottom: var(--space-3);
    filter: drop-shadow(0 2px 10px rgba(10, 17, 34, 0.55));
  }
  .hero h1 {
    color: var(--on-navy);
    font-size: var(--step-4);
    line-height: 1.05;
    max-width: 22ch;
    margin-bottom: var(--space-2);
    text-shadow: 0 2px 18px rgba(10, 17, 34, 0.55);
  }
  .hero-intro {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 38rem;
    color: var(--on-navy);
    margin: 0 auto var(--space-4);
    text-shadow: 0 1px 12px rgba(10, 17, 34, 0.6);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .hero :focus-visible {
    box-shadow: var(--focus-dark);
  }

  /* ── Next event: a straight invitation card on a subdued photographic band ── */
  .invite-band {
    position: relative;
    padding-block: var(--space-5);
    background: var(--navy);
    overflow: hidden;
  }
  /* On wide screens the card sits to the right so the photograph shows on the left. */
  @media (min-width: 64rem) {
    .invite-band { padding-block: var(--space-6); }
    .invite-band .card { margin-inline: 0 auto; }
    /* The card sits left; the photo is slightly oversized from the left edge so the dancers
       and the saltires on the far wall stay in the clear right half. */
    .band-img { width: 118%; left: 0; object-position: 0% 30%; }
  }
  .band-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 36%;
  }
  .band-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(14, 24, 48, 0.78) 0%, rgba(14, 24, 48, 0.5) 50%, rgba(14, 24, 48, 0.3) 100%);
  }
  .card {
    position: relative;
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--space-4) var(--space-4) var(--space-4);
    background: var(--paper);
    text-align: center;
    border-radius: 3px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.65);
    outline: 1px solid var(--navy);
    outline-offset: -12px;
  }
  .card-kicker {
    display: flex;
    flex-direction: column;
    align-items: center;
    font: 700 var(--step--1) / 1.2 var(--font-body);
    letter-spacing: 0.06em;
    color: var(--red-text);
    margin-bottom: var(--space-2);
  }
  .card-kicker .accent-rule {
    margin-bottom: 0.6rem;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card li,
  .card p {
    max-width: none;
  }
  .card-title {
    font: 600 var(--step-4) / 1.02 var(--font-display);
    color: var(--navy);
    margin-bottom: var(--space-2);
    text-wrap: balance;
  }
  .card-title a {
    color: inherit;
    text-decoration: none;
  }
  .card-title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .card-date {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.1rem;
  }
  .card-time {
    color: var(--ink-soft);
    margin-bottom: 0.1rem;
  }
  .card-venue {
    color: var(--ink);
    margin-bottom: var(--space-3);
  }
  .card-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  /* ── About ── */
  .about {
    padding-block: var(--space-6) var(--space-5);
  }
  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-4) var(--space-5);
  }
  .about-lead {
    font: 500 var(--step-2) / 1.3 var(--font-display);
    color: var(--navy);
  }
  .objectives {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .objectives li {
    position: relative;
    padding: 0 0 var(--space-3) 1.6rem;
    line-height: 1.55;
  }
  .objectives li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--green);
  }

  /* ── Why join: a paper panel on cream ── */
  .join {
    padding-bottom: var(--space-6);
  }
  .join-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 1fr);
    gap: var(--space-4);
    align-items: center;
    background: var(--paper);
    border-radius: var(--radius);
    padding: var(--space-5) clamp(1.5rem, 5vw, 4rem);
    box-shadow: 0 1px 0 var(--stone-deep);
    border-top: 4px solid var(--green);
  }
  .benefits {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .benefits li {
    display: flex;
    flex-direction: column;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--stone);
  }
  .benefits span {
    color: var(--ink-soft);
  }
  .join-aside {
    text-align: center;
  }
  .price {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-1);
    max-width: none;
  }
  .price-value {
    /* Prices in Source Sans: Cormorant's "1" reads as "I". */
    font: 700 var(--step-3) / 1.1 var(--font-body);
    color: var(--navy);
  }
  .price-label,
  .join-note {
    color: var(--ink-soft);
  }
  .join-note {
    margin-bottom: var(--space-3);
  }

  /* ── Highlights and committee: image-led cards with caption panels ── */
  .highlights {
    padding-bottom: var(--space-6);
  }
  .committee {
    background: var(--stone);
    padding-block: var(--space-6);
  }
  .cards,
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4) var(--space-3);
  }
  .cards {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  .cards img {
    aspect-ratio: 4 / 3;
  }
  /* The committee row scrolls sideways so every member is shown; arrows appear where there's a pointer. */
  .people-slider {
    position: relative;
  }
  .people {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.25rem;
    padding: 0.25rem 0.25rem var(--space-2);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .people::-webkit-scrollbar {
    display: none;
  }
  .people li {
    flex: 0 0 clamp(11rem, 60vw, 14rem);
    scroll-snap-align: start;
  }
  .slider-btn {
    position: absolute;
    top: 42%;
    z-index: 2;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgba(20, 33, 61, 0.2);
    background: var(--paper);
    color: var(--navy);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--shadow-card);
    display: none;
  }
  .slider-prev { left: -1.25rem; }
  .slider-next { right: -1.25rem; }
  .slider-btn[disabled] { opacity: 0.35; cursor: default; }
  @media (hover: hover) and (min-width: 48rem) {
    .slider-btn { display: grid; place-items: center; }
  }
  .cards li,
  .people li {
    max-width: none;
  }
  .committee-intro {
    font-size: var(--step-1);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 48rem) {
    .hero {
      min-height: auto;
    }
    .hero-copy {
      padding-block: 6.5rem var(--space-5);
    }
    .card {
      padding: var(--space-4) var(--space-3);
    }
    .join-panel {
      grid-template-columns: 1fr;
      padding: var(--space-4) var(--space-3);
    }
  }
</style>
