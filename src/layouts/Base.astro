---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/content';

interface Props {
  title: string;
  description: string;
  /** Social share image; falls back to /og-default.jpg. */
  image?: ImageMetadata | null;
  imageAlt?: string | null;
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Lay the header over the first section (full-bleed hero). */
  overlayHeader?: boolean;
}

const { title, description, image, imageAlt, noindex = false, type = 'website', overlayHeader = false } = Astro.props;
// Pre-launch builds are never indexed; set SITE_LAUNCHED=true in Netlify at launch.
const launched = process.env.SITE_LAUNCHED === 'true';
const settings = await getSettings();
const fullTitle = Astro.url.pathname === '/' ? settings.site_name : `${title} | ${settings.site_name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const og = image
  ? new URL((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site)
  : new URL('/og-default.jpg', Astro.site);
const ogAlt = image ? imageAlt ?? '' : `${settings.site_name} logo: a thistle with the Society's name arched above it`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || !launched) && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#14213d" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={settings.site_name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 100;
    background: var(--warm-white);
    color: var(--navy);
    padding: 0.75rem 1rem;
    font-weight: 700;
    border-radius: var(--radius);
  }
  .skip-link:focus {
    top: 1rem;
  }
  main:focus {
    outline: none;
  }
</style>
